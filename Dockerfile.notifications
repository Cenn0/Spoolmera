# Optional standalone polling-to-ntfy bridge. No app database, printer tokens or code.
FROM python:3.12-slim-trixie@sha256:05cda9777409a9c3ffddd94a4c476b79f0769a0b4857f0c7ed9226b6800b0d6f
WORKDIR /worker
COPY scripts/notification_bridge.py ./
COPY LICENSE THIRD_PARTY_LICENSES.md /usr/share/doc/spoolmera/
RUN groupadd --gid 10002 notifier \
    && useradd --uid 10002 --gid notifier --no-create-home notifier \
    && mkdir /state && chown notifier:notifier /state
USER notifier
CMD ["python","-u","notification_bridge.py","--loop"]
