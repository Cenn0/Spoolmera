# Copy to .env and set a unique random bootstrap token.
# Generate using: python -c 'import secrets; print(secrets.token_urlsafe(32))'
FILAMENT_BOOTSTRAP_TOKEN=
FILAMENT_COOKIE_SECURE=0
FILAMENT_PUBLIC_BASE_URL=http://127.0.0.1:8765
FILAMENT_PRINTER_ALLOWED_IPS=
FILAMENT_PRINTER_POLL_SECONDS=30
# Optional API keys, e.g.:
# FILAMENT_PRINTER_TOKEN_WORKSHOP=
