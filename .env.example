# Copy to .env and set a unique random bootstrap token.
# Generate using: python -c 'import secrets; print(secrets.token_urlsafe(32))'
FILAMENT_BOOTSTRAP_TOKEN=
FILAMENT_COOKIE_SECURE=0
FILAMENT_PUBLIC_BASE_URL=http://127.0.0.1:8765
FILAMENT_PRINTER_ALLOWED_IPS=
FILAMENT_PRINTER_POLL_SECONDS=30
# Optional API keys, e.g.:
# FILAMENT_PRINTER_TOKEN_WORKSHOP=

# Optional physical control and file transfers (admin only; OFF by default)
FILAMENT_PRINTER_CONTROL_ENABLED=0

# Optional PrusaSlicer CLI: install via Docker build arg and mount approved INI profiles
FILAMENT_SLICER_ENABLED=0
FILAMENT_SLICER_EXECUTABLE=/usr/bin/prusa-slicer
# Required for compose.slicer.yaml; generate with secrets.token_urlsafe(32).
FILAMENT_SLICER_WORKER_TOKEN=
# Set only through the optional slicer Compose overlay.
# FILAMENT_SLICER_WORKER_URL=http://slicer-worker:8767
FILAMENT_SLICER_PROFILES_DIR=/config/slicer-profiles

# Cloud relays must be operator-owned. Generate random 32+ character HMAC secret:
# FILAMENT_CLOUD_HMAC_FARM=

# Bind every configured signed relay to one printer ID (must match its job's printer_id).
# FILAMENT_CLOUD_PRINTER_FARM=1

# Optional community catalog lookups (requires outbound HTTPS).
FILAMENT_CATALOG_ENABLED=0
