# Copy to .env and set a unique random bootstrap token.
# Optional prebuilt image for controlled upgrades: select only a verified
# promoted GHCR manifest digest using scripts/pin_published_image.py.
# Do not paste an unverified candidate digest, or use moving :main in production.
# SPOOLMERA_IMAGE=ghcr.io/cenn0/spoolmera@sha256:<verified-64-hex-digits>
# Generate using: python -c 'import secrets; print(secrets.token_urlsafe(32))'
SPOOLMERA_BOOTSTRAP_TOKEN=
SPOOLMERA_COOKIE_SECURE=0
SPOOLMERA_PUBLIC_BASE_URL=http://127.0.0.1:8765
SPOOLMERA_PRINTER_ALLOWED_IPS=
SPOOLMERA_PRINTER_POLL_SECONDS=30
# Validated at startup: interval 10–300 seconds; booleans must be 0 or 1.
SPOOLMERA_BACKUP_TIMEOUT_SECONDS=30
SPOOLMERA_STORAGE_RESERVE_MIB=64
# Optional API keys, e.g.:
# SPOOLMERA_PRINTER_TOKEN_WORKSHOP=
# Bambu Lab LAN: replace _BAMBU1 with the suffix of the configured token alias.
# SPOOLMERA_PRINTER_TOKEN_BAMBU1=<LAN access code from printer>
# SPOOLMERA_BAMBU_CERT_SHA256_BAMBU1=<64 hex SHA-256 of printer TLS leaf certificate>

# Optional physical control and file transfers (admin only; OFF by default)
SPOOLMERA_PRINTER_CONTROL_ENABLED=0

# Optional isolated PrusaSlicer worker; enable through compose.slicer.yaml.
SPOOLMERA_SLICER_ENABLED=0
SPOOLMERA_SLICER_EXECUTABLE=/usr/bin/prusa-slicer
# Required for compose.slicer.yaml; generate with secrets.token_urlsafe(32).
SPOOLMERA_SLICER_WORKER_TOKEN=
# Set only through the optional slicer Compose overlay.
# SPOOLMERA_SLICER_WORKER_URL=http://slicer-worker:8767
SPOOLMERA_SLICER_PROFILES_DIR=/config/slicer-profiles

# Cloud relays must be operator-owned. Generate random 32+ character HMAC secret:
# SPOOLMERA_CLOUD_HMAC_FARM=

# Bind every configured signed relay to one printer ID (must match its job's printer_id).
# SPOOLMERA_CLOUD_PRINTER_FARM=1

# Optional community catalog lookups (requires outbound HTTPS).
SPOOLMERA_CATALOG_ENABLED=0

# Optional signed scale adapter; 32+ random characters per device.
# SPOOLMERA_SCALE_HMAC_WORKSHOP=

# Optional notification bridge, enabled only by compose.notifications.yaml.
# SPOOLMERA_AUTOMATION_TOKEN=<events_read token created in Integrations>
# SPOOLMERA_NTFY_URL=http://ntfy:80/filament
# Optional authentication for the target ntfy server; never reuse the app token.
# SPOOLMERA_NTFY_TOKEN=
# SPOOLMERA_NOTIFICATION_CATEGORIES=low_stock,job_review,printer_offline
